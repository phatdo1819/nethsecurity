# Convert legacy Road Warrior users to explicit per-instance membership (openvpn_instances).
# Each legacy user is added to all the instances using its user database, so access
# does not change after the upgrade.
# uci-defaults scripts are sourced by sh, so the Python code is passed to the interpreter.

python3 - <<'EOF'
from euci import EUci
from nethsec import ovpn

u = EUci()
if ovpn.migrate_user_memberships(u) > 0:
    u.commit("users")
EOF
