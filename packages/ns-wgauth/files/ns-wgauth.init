# Before the network: the gate of the WireGuard servers must exist before their interfaces come up
START=15
USE_PROCD=1

start_service() {
	# the daemon works on the configuration applied here, changes not applied yet don't reach it
	/usr/sbin/ns-wgauth sync || logger -t ns-wgauth -p daemon.err "sync failed, the daemon will retry"
	# the daemon runs only while a server requires the login, the triggers below start it when needed
	/usr/sbin/ns-wgauth needed || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/ns-wgauth serve
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# the configuration is applied with a reload, that runs start_service again: new servers, peers, users and
	# passwords take effect
	procd_add_reload_trigger "network" "users" "ns-wgauth"
}
