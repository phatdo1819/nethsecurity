# The connection history of the WireGuard servers, every minute: see nethsec.wghistory

mkdir -p /etc/crontabs
if ! grep -qs '/usr/libexec/wireguard-history' /etc/crontabs/root; then
  echo '* * * * * /usr/libexec/wireguard-history' >> /etc/crontabs/root
fi
